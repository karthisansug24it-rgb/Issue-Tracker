# ====================================================================
# DevTrack - Full Stack Environment Configuration Template
# Copy this file to .env and adjust the values:
#   Windows:     copy .env.example .env
#   Linux/macOS: cp .env.example .env
# .env is git-ignored. Never commit real credentials or secrets.
# ====================================================================

# ----------------- Backend Configuration (Spring Boot) -----------------
# Active Spring Profile: 'postgres' for PostgreSQL 18, 'default' for zero-config H2
SPRING_PROFILES_ACTIVE=postgres
SERVER_PORT=8080

# PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devtrack
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT Security: REQUIRED for shared/production use, at least 32 characters.
# Generate one with:  openssl rand -hex 32
# If left empty, a random key is used and everyone is signed out on each restart.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Browser origins allowed to call the API (only matters for Flutter web)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# First Super Admin, created only when no active Super Admin exists.
# Leave the password empty to have one generated and printed once in the server log.
BOOTSTRAP_ADMIN_EMAIL=superadmin@devtrack.com
BOOTSTRAP_ADMIN_PASSWORD=

# Load demo departments/teams/projects/issues and demo accounts on an EMPTY database.
# Set to false for real deployments.
SEED_DEMO_DATA=true

# H2 web console (default profile only, localhost only). Keep false unless debugging.
H2_CONSOLE_ENABLED=false

# ----------------- Frontend / Desktop Configuration -----------------
# Passed to Flutter with: flutter run --dart-define=API_BASE_URL=...
API_BASE_URL=http://localhost:8080/api/v1
