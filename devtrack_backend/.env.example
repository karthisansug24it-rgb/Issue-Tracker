# ====================================================================
# DevTrack Backend - Environment Variables Template
# Copy this file to .env and customize for your environment:
#   copy .env.example .env
# ====================================================================

# Profile Selection:
# Use 'postgres' for local/production PostgreSQL 18
# Use 'default' for zero-config embedded H2 (with PostgreSQL compatibility)
SPRING_PROFILES_ACTIVE=postgres

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devtrack
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Optional full JDBC URL (overrides DB_HOST/PORT/NAME if set)
# DB_URL=jdbc:postgresql://localhost:5432/devtrack

# JWT Authentication Security (Minimum 256-bit secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
